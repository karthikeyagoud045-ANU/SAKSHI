# SAKSHI Backend Worker Environment Variables
# Copy this file to .env and fill in the values

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# LLM Configuration
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=your_llm_model_here  # e.g., gpt-4, claude-3, etc.

# Whisper ASR Configuration
WHISPER_MODEL=base  # Options: tiny, base, small, medium, large
VAD_SILENCE_MS=600  # Silence threshold in ms for voice activity detection

# Demo Mode
DEMO_MODE=false  # Set to true to enable /demo/reset endpoint

# WhatsApp DAK Configuration
WA_MODE=simulator  # Options: simulator, cloud_test
# WHATSAPP_TOKEN=your_whatsapp_cloud_api_token_here  # Required for WA_MODE=cloud_test

# Other Configuration
# Add any additional environment variables as needed